  "phases": [
    {
      "id": "deployment",
      "title": "산 아래의 대군",
      "dialogue": [
        { "speaker": "장손무기", "side": "player", "portrait": "assets/portraits/sun_bin.png", "text": "폐하, 고구려군의 대열이 산 아래를 가득 메웠습니다. 수가 너무 많습니다." },
        { "speaker": "이세적", "side": "player", "portrait": "assets/portraits/wei_qing.png", "text": "정면으로 부딪치면 오래 버티기 어렵습니다." },
        { "speaker": "당태종", "side": "player", "portrait": "assets/portraits/wang_jian.png", "text": "그러니 정면은 이기는 곳이 아니라 붙잡는 곳이다." },
        { "speaker": "설인귀", "side": "player", "portrait": "assets/portraits/huo_qubing.png", "text": "폐하, 산길을 돌아 적의 뒤를 칠 기회를 주십시오." },
        { "speaker": "당태종", "side": "player", "portrait": "assets/portraits/wang_jian.png", "text": "좋다. 정면은 고정하고, 별동대는 산길로 돌아 후방 진지를 노린다." },
        { "speaker": "고연수", "side": "enemy", "portrait": "assets/portraits/yeon_gaesomun.png", "camera": { "x": 146, "y": 82 }, "text": "당군은 적다. 중앙을 눌러 황제를 사로잡아라!" }
      ],
      "briefing": {
        "text": "정면 부대는 방어선에 세우고, 설인귀와 계필하력은 산악 우회로 입구로 이동시키십시오.",
        "camera": { "x": 68, "y": 92 },
        "markers": [
          { "id": "front_line", "type": "rect", "label": "정면 방어선", "x": 58, "y": 66, "w": 20, "h": 34 },
          { "id": "bypass_start", "label": "우회로 입구", "x": 50, "y": 112, "radius": 8 }
        ]
      },
