        { "id": "bypass_ready", "type": "formationsAtArea", "formationIds": [ "xue_rengui", "qibi_heli" ], "x": 50, "y": 112, "radius": 8, "label": "설인귀와 계필하력을 우회로 입구에 집결시키십시오." }
