    {
      "id": "pursuit",
      "title": "귀주의 추격",
      "dialogue": [
        { "speaker": "소배압", "side": "enemy", "portrait": "assets/portraits/so_bae_ap.png", "camera": { "x": 180, "y": 84 }, "text": "대열을 버려라! 살아남은 자는 동쪽으로 빠져나가라!" },
        { "speaker": "고려 궁병대장", "side": "player", "portrait": "assets/portraits/huang_zhong.png", "text": "적의 깃발이 무너졌습니다!" },
        { "speaker": "강감찬", "side": "player", "portrait": "assets/portraits/gang_gamchan.png", "text": "끝까지 추격하라. 다시는 고려의 강을 넘보지 못하게 하라." },
        { "speaker": "김종현", "side": "player", "portrait": "assets/portraits/kim_yusin.png", "text": "선봉은 흩어졌고 중군도 무너졌습니다." },
        { "speaker": "강감찬", "side": "player", "portrait": "assets/portraits/gang_gamchan.png", "text": "오늘의 승리는 병사의 칼뿐 아니라, 기다림이 만든 것이다." },
        { "speaker": "조원", "side": "player", "portrait": "assets/portraits/gyebaek.png", "text": "귀주 벌판이 적의 퇴로를 삼키고 있습니다!" }
