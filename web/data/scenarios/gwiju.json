        { "id": "cavalry_ready", "type": "formationsAtArea", "formationIds": [ "kim_jonghyeon", "jo_won" ], "x": 52, "y": 78, "radius": 40, "label": "양쪽 기병을 매복 구역에 배치하십시오." }
